generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  games    Game[]
}

model Game {
  id          Int    @id @default(autoincrement())
  title       String
  coverUrl    String
  description String
  genre       String
  releaseDate String
  rating      String
  userId      Int
  personalRating Int?
  user        User   @relation(fields: [userId], references: [id])
}
