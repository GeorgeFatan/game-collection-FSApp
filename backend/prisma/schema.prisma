datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String

  games    Game[]
}

model Game {
  id          Int     @id @default(autoincrement())
  title       String
  coverUrl    String
  description String
  genre       String
  releaseDate String
  rating      String

  userId      Int
  user        User    @relation(fields: [userId], references: [id])
}
